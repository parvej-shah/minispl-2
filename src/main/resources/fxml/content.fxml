<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="16.0" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.socialmediamanager.ui.ContentController">
    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/>
    </padding>

    <VBox prefWidth="260.0" spacing="8.0">
        <Label text="Content" style="-fx-font-weight: bold;"/>
        <ListView fx:id="contentListView" VBox.vgrow="ALWAYS"/>
        <Button text="New" onAction="#handleNew"/>
        <Button text="Delete" onAction="#handleDelete"/>
    </VBox>

    <VBox spacing="8.0" HBox.hgrow="ALWAYS">
        <Label text="Title"/>
        <TextField fx:id="titleField"/>
        <Label text="Type"/>
        <ComboBox fx:id="contentTypeComboBox"/>
        <Label text="Body"/>
        <TextArea fx:id="bodyField" VBox.vgrow="ALWAYS"/>
        <HBox spacing="8.0">
            <Button text="Save" onAction="#handleSave"/>
        </HBox>
        <Label fx:id="statusLabel"/>
    </VBox>
</HBox>
