<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.socialmediamanager.ui.DashboardController">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0"/>
    </padding>

    <Label text="Social Media Manager" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    <Label fx:id="summaryLabel" text="Dashboard loading..." style="-fx-font-size: 14px;"/>

    <HBox spacing="12.0" alignment="CENTER">
        <Button fx:id="manageContentButton" text="Manage Content" onAction="#handleOpenContent"/>
        <Button fx:id="managePostsButton" text="Manage Posts" onAction="#handleOpenPosts"/>
        <Button fx:id="scheduledPostsButton" text="Scheduled Posts" onAction="#handleOpenScheduledPosts"/>
        <Button fx:id="publishingHistoryButton" text="Publishing History" onAction="#handleOpenPublishingHistory"/>
    </HBox>
</VBox>
