<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.socialmediamanager.ui.PublishingHistoryController">
    <fx:include fx:id="navBar" source="nav_bar.fxml"/>

    <VBox VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="16.0"/>
        </padding>

        <VBox spacing="3.0" styleClass="page-header, page-header-accent-green">
            <Label text="Publishing History" styleClass="page-title"/>
            <Label text="Every publish attempt and its result, newest first"
                   styleClass="page-subtitle"/>
        </VBox>

        <VBox spacing="12.0" VBox.vgrow="ALWAYS" styleClass="content-card">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>

            <HBox spacing="8.0" alignment="CENTER_LEFT">
                <Label text="RESULT" styleClass="field-label"/>
                <ComboBox fx:id="resultFilterComboBox" promptText="Any"/>
                <Label text="PLATFORM" styleClass="field-label"/>
                <ComboBox fx:id="platformFilterComboBox" promptText="Any"/>
                <Button text="Apply Filter" onAction="#handleApplyFilter" styleClass="button-primary"/>
                <Button text="Clear" onAction="#handleClearFilter"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="resultCountLabel" styleClass="hint-text"/>
            </HBox>

            <ListView fx:id="historyListView" VBox.vgrow="ALWAYS">
                <placeholder>
                    <Label text="No publishing history yet. Publish a post to see it here."
                           wrapText="true" styleClass="hint-text"/>
                </placeholder>
            </ListView>

            <Label fx:id="messageLabel" wrapText="true"/>
        </VBox>
    </VBox>
</VBox>
