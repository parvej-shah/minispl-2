<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.socialmediamanager.ui.PostController">
    <fx:include fx:id="navBar" source="nav_bar.fxml"/>

    <HBox spacing="16.0" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/>
        </padding>

        <VBox prefWidth="280.0" spacing="8.0">
            <Label text="Posts" style="-fx-font-weight: bold;"/>
            <ListView fx:id="postListView" VBox.vgrow="ALWAYS">
                <placeholder>
                    <Label text="No posts yet. Pick content and a platform, then Create Draft."
                           wrapText="true"/>
                </placeholder>
            </ListView>
        </VBox>

        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
            <Label text="Content"/>
            <ComboBox fx:id="contentComboBox" maxWidth="Infinity"/>
            <Label text="Platform"/>
            <ComboBox fx:id="platformComboBox" maxWidth="Infinity"/>
            <VBox fx:id="scheduleBox" spacing="6.0">
                <Label text="Schedule date"/>
                <DatePicker fx:id="scheduleDatePicker" maxWidth="Infinity"/>
                <Label text="Schedule time (HH:mm)"/>
                <TextField fx:id="scheduleTimeField" promptText="14:30"/>
            </VBox>
            <Label fx:id="statusLabel" style="-fx-font-weight: bold;"/>

            <HBox spacing="8.0">
                <Button text="Create Draft" onAction="#handleCreateDraft"/>
                <Button text="Validate" onAction="#handleValidate"/>
                <Button fx:id="scheduleButton" text="Schedule" onAction="#handleSchedule"/>
                <Button text="Cancel" onAction="#handleCancel"/>
                <Button text="Simulate Publish" onAction="#handleSimulatePublish"/>
            </HBox>
            <Label fx:id="messageLabel"/>
        </VBox>
    </HBox>
</VBox>
