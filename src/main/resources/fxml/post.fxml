<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="16.0" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.socialmediamanager.ui.PostController">
    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/>
    </padding>

    <VBox prefWidth="280.0" spacing="8.0">
        <Label text="Posts" style="-fx-font-weight: bold;"/>
        <ListView fx:id="postListView" VBox.vgrow="ALWAYS"/>
    </VBox>

    <VBox spacing="10.0" HBox.hgrow="ALWAYS">
        <Label text="Content"/>
        <ComboBox fx:id="contentComboBox" maxWidth="Infinity"/>
        <Label text="Platform"/>
        <ComboBox fx:id="platformComboBox" maxWidth="Infinity"/>
        <Label fx:id="statusLabel" style="-fx-font-weight: bold;"/>

        <HBox spacing="8.0">
            <Button text="Create Draft" onAction="#handleCreateDraft"/>
            <Button text="Validate" onAction="#handleValidate"/>
            <Button text="Schedule" onAction="#handleSchedule"/>
            <Button text="Cancel" onAction="#handleCancel"/>
        </HBox>
        <Label fx:id="messageLabel"/>
    </VBox>
</HBox>
